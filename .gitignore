# --- Palworld save data ---------------------------------------------------
# paleditor runs next to a live save directory, and the fixture backend reads a
# Level.sav that is really JSON. Neither belongs in git: a world is hundreds of
# megabytes, it is not ours to publish, and it holds every player's inventory.
*.sav
*.sav.*
*.sav.sha256
Level.sav
LevelMeta.sav
WorldOption.sav
Players/
backups/
*.sav.tmp
*.paleditor-*.tmp

# --- Secrets and local configuration -------------------------------------
# Only paleditor.example.toml is committed. A real config carries argon2
# hashes, and rcon.secret carries the RCON password in plain text.
paleditor.toml
*.secret
rcon.secret
config/*.toml
!config/paleditor.example.toml
.env
.env.*
!.env.example

# --- Database -------------------------------------------------------------
# Rebuilt by ingest, except for the app-owned tables, which are backed up
# separately rather than committed.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
paleditor.db*

# --- Runtime state --------------------------------------------------------
*.lock
!package-lock.json
!yarn.lock
*.pid
*.log
logs/

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

