# paleditor, running beside the game server on the same VPS.
#
#   install -d -o palworld -g palworld /var/lib/paleditor
#   cp config/paleditor.service /etc/systemd/system/
#   # EDIT ReadWritePaths BELOW BEFORE STARTING - see the note there
#   systemctl daemon-reload && systemctl enable --now paleditor
#
# Check the unit against your config before starting it:
#   paleditor check-service -c /etc/paleditor/paleditor.toml

[Unit]
Description=paleditor (Palworld chest browser)
Documentation=https://github.com/ifish86/paleditor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as the game server's own user, which is the simplest arrangement that
# actually works:
#
#   * the save usually sits in that user's home, which is mode 0700 on a
#     stock setup, so no other user can even traverse into it
#   * whoever writes Level.sav owns the replacement. Running as anyone else
#     leaves the save owned by the wrong user after the first maintenance
#     window, and the game server then cannot write its own save
#
# To use a separate service account instead, see docs/deployment.md: it needs
# the execute bit on the game user's home and a way to restore the save's
# ownership after a write.
User=palworld
Group=palworld
WorkingDirectory=/opt/paleditor
ExecStart=/opt/paleditor/.venv/bin/paleditor serve -c /etc/paleditor/paleditor.toml
Restart=on-failure
RestartSec=5

StateDirectory=paleditor
RuntimeDirectory=paleditor

# Hardening. The save directory is the only path outside its own state that
# paleditor needs to write.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# ---------------------------------------------------------------------------
# EDIT THIS LINE. Replace the placeholder with the SaveGames directory holding
# your world - the parent of the <world-id> folder, which is the part of
# [palworld] save_dir above the world id. For example, if save_dir is
#
#   /home/palworld/palworld-server/Pal/Saved/SaveGames/0/ABC123...
#
# then put /home/palworld/palworld-server/Pal/Saved/SaveGames here.
#
# Every path listed must already exist. systemd sets up the mount namespace
# before the service runs, so a path that is missing or misspelled fails the
# whole unit with the rather unhelpful:
#
#   Failed to set up mount namespacing: ...: No such file or directory
#   Failed at step NAMESPACE ... status=226/NAMESPACE
#
# ReadWritePaths overrides ProtectHome=read-only for the paths it lists, so a
# save directory under /home is fine.
# ---------------------------------------------------------------------------
ReadWritePaths=/var/lib/paleditor /REPLACE-WITH-YOUR-SaveGames-DIRECTORY

[Install]
WantedBy=multi-user.target
